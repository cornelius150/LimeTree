{
  "name": "limetree",
  "version": "2.0.0",
  "description": "LimeTree - Desktop tree-structure note-taking app",
  "main": "electron/main.cjs",
  "author": "LimeTree",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:vue": "vite build",
    "dev": "vite",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.limetree.app",
    "productName": "LimeTree",
    "directories": {
      "output": "E:/MY-LimeTree02"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "src/assets/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LimeTree"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@tiptap/extension-color": "^2.27.0",
    "@tiptap/extension-highlight": "^2.27.0",
    "@tiptap/extension-table": "^2.27.0",
    "@tiptap/extension-table-cell": "^2.27.0",
    "@tiptap/extension-table-header": "^2.27.0",
    "@tiptap/extension-table-row": "^2.27.0",
    "@tiptap/extension-text-style": "^2.27.0",
    "@tiptap/extension-underline": "^2.27.0",
    "@tiptap/starter-kit": "^2.27.0",
    "@tiptap/vue-3": "^2.27.0",
    "isomorphic-git": "^1.42.2",
    "sql.js": "^1.14.2",
    "tiptap-markdown": "^0.8.10",
    "vue": "^3.5.0"
  }
}
